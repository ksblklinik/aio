# ==============================================================================
# aio SaaS Framework Environment Configuration (.env)
# ==============================================================================

# Application Setup
APP_NAME="aio SaaS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (SQLite)
DB_CONNECTION=sqlite
DB_PATH=database.sqlite
DB_FOREIGN_KEYS=true

# Queue & Webhooks
QUEUE_CONNECTION=database
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3

# Storage Configuration
STORAGE_DRIVER=local

# Mail Service
MAIL_DRIVER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="aio SaaS"
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=


# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug

# AI Gateway & LLM Orchestration
AI_DRIVER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

