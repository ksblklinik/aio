# ==============================================================================
# Environment Configuration Template (.env.example)
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN PERNAH MENYIMPAN TOKEN ATAU SECRET ASLI KE DALAM FILE INI ATAU KE GIT!
# ==============================================================================

# Server / Runtime
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Connection (Contoh: SQLite lokal atau PostgreSQL)
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/jstudio_dev"

# Authentication & Security
# Generate secure random secret: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
# JWT_SECRET="change-me-to-another-secure-random-string"

# Logging & Debugging
LOG_LEVEL=debug
